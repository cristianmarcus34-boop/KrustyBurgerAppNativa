{
  "expo": {
    "name": "KrustyBurger",
    "slug": "KrustyBurger",
    "version": "1.0.0",
    "scheme": "krustyburger",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agenciapowa.KrustyBurger",
      "config": {
        "googleMapsApiKey": "AIzaSyCiAUoNj0Pf_U9hZvctk2wCToe-AjJvC1I"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "KrustyBurger necesita acceso a la cámara para escanear códigos QR y cupones.",
