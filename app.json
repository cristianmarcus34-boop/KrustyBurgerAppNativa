{
  "expo": { // Raíz de toda la config de Expo. Acá vive todo.
    "name": "KrustyBurger", // Nombre visible de la app en el celu y en las tiendas.
    "slug": "KrustyBurger", // Identificador interno del proyecto en Expo. No lo cambies si ya publicaste.
    "version": "1.0.4", // Versión visible para el usuario (la que ves en Play Store).
    "scheme": "krustyburger", // Deep linking: permite abrir la app con krustyburger://algo.
    "orientation": "portrait", // Bloquea la app en vertical. No se da vuelta si el user acuesta el celu.
    "icon": "./assets/icon.png", // Ícono principal de la app (el que se ve en el launcher).
    "userInterfaceStyle": "automatic", // Respeta el modo claro/oscuro del sistema operativo.
    "ios": { // Bloque de config específica de iOS.
      "supportsTablet": true, // Permite que la app corra en iPad, no solo en iPhone.
      "bundleIdentifier": "com.agenciapowa.KrustyBurger", // ID único de la app en iOS. Es como el DNI de la app en App Store.
      "infoPlist": { // Permisos y config nativa que se inyecta en el Info.plist de iOS.
        "NSCameraUsageDescription": "KrustyBurger necesita acceso a la cámara para escanear códigos QR y cupones.", // Texto que iOS muestra cuando pide permiso de cámara. Obligatorio o Apple te rebota.
        "NSPhotoLibraryUsageDescription": "KrustyBurger necesita acceso a tus fotos para subir imágenes.", // Texto del permiso de galería de fotos.
        "NSLocationWhenInUseUsageDescription": "KrustyBurger necesita tu ubicación para el seguimiento de pedidos.", // Permiso de ubicación mientras usás la app.
        "NSLocationAlwaysUsageDescription": "KrustyBurger necesita tu ubicación para el seguimiento de pedidos.", // Permiso de ubicación siempre (incluso en background). Ojo que Apple es rompebolas con esto.
        "UIBackgroundModes": [ // Modos que la app puede correr en segundo plano.
          "location", // Permite seguir la ubicación en background (para tracking de pedidos).
          "fetch", // Permite traer datos en background.
          "remote-notification" // Permite recibir push notifications y despertar la app.
        ]
      }
    },
    "android": { // Bloque de config específica de Android.
      "adaptiveIcon": { // Ícono adaptativo de Android (el que cambia de forma según el launcher).
        "backgroundColor": "#FF6600", // Color de fondo del ícono adaptativo.
        "foregroundImage": "./assets/android-icon-foreground.png", // Capa frontal del ícono.
        "backgroundImage": "./assets/android-icon-background.png", // Capa de fondo del ícono.
        "monochromeImage": "./assets/android-icon-monochrome.png" // Versión monocromática para temas dinámicos de Android 13+.
      },
      "versionCode": 10, // Número de versión interno de Android. Cada subida a Play Store TIENE que ser mayor. Si no, te rebota.
      "predictiveBackGestureEnabled": false, // Desactiva el gesto de "atrás" predictivo de Android 13+. Lo apagás para que no rompa la navegación.
      "googleServicesFile": "./google-services.json", // Archivo de config de Firebase. Necesario para push notifications, analytics, etc.
      "package": "com.agenciapowa.KrustyBurger", // ID único de la app en Android. Es el DNI en Play Store. No se puede cambiar después de publicar.
      "blockedPermissions": [ // Permisos que EXPLÍCITAMENTE bloqueás. Útil cuando una librería los inyecta y no los querés.
        "android.permission.READ_MEDIA_IMAGES", // Bloquea lectura de imágenes del storage (Android 13+).
        "android.permission.READ_MEDIA_VIDEO", // Bloquea lectura de videos.
        "android.permission.READ_MEDIA_AUDIO", // Bloquea lectura de audios.
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED", // Bloquea el acceso parcial a media.
        "android.permission.READ_EXTERNAL_STORAGE", // Bloquea lectura de storage externo (Android viejo).
        "android.permission.WRITE_EXTERNAL_STORAGE", // Bloquea escritura en storage externo.
        "android.permission.RECORD_AUDIO" // Bloquea grabación de audio. Si no usás micrófono, mejor bloquearlo.
      ],
      "permissions": [ // Permisos que SÍ pedís explícitamente.
        "android.permission.ACCESS_FINE_LOCATION", // Ubicación precisa (GPS).
        "android.permission.ACCESS_COARSE_LOCATION", // Ubicación aproximada (por red/wifi).
        "android.permission.CAMERA", // Acceso a la cámara (para escanear QR).
        "android.permission.RECEIVE_BOOT_COMPLETED", // Permite que la app reciba el evento de "el celu se reinició". Útil para notificaciones programadas.
        "android.permission.VIBRATE", // Permite hacer vibrar el celu.
        "android.permission.WAKE_LOCK", // Permite mantener el celu despierto (para procesos en background).
        "android.permission.INTERNET", // Acceso a internet. Sin esto no hay app.
        "android.permission.ACCESS_NETWORK_STATE", // Permite saber si hay conexión a internet.
        "android.permission.ACCESS_WIFI_STATE", // Permite saber el estado del WiFi.
        "android.permission.POST_NOTIFICATIONS" // Permite mostrar notificaciones (Android 13+ lo pide explícito).
      ],
      "intentFilters": [ // Filtros de intents: qué links o acciones abren tu app.
        {
          "action": "VIEW", // Acción de "ver" un link.
          "data": [ // Qué URLs abren tu app.
            {
              "scheme": "https", // Protocolo HTTPS.
              "host": "www.krustyburger.com.ar" // Dominio con www que abre la app.
            },
            {
              "scheme": "https", // Protocolo HTTPS.
              "host": "krustyburger.com.ar" // Dominio sin www que también abre la app.
            }
          ],
          "category": [ // Categorías del intent.
            "BROWSABLE", // Permite que el link se abra desde un navegador.
            "DEFAULT" // Categoría default para que el sistema lo tome en cuenta.
          ]
        }
      ]
    },
    "plugins": [ // Lista de plugins de Expo. Cada uno agrega config nativa o funcionalidad.
      "expo-secure-store", // Guarda datos sensibles encriptados (tokens, passwords). Usa Keychain/Keystore.
      "expo-router", // Sistema de navegación basado en archivos (como Next.js pero para RN).
      "expo-status-bar", // Controla la barra de estado (hora, batería, etc.).
      "expo-font", // Permite cargar fuentes custom.
      "expo-updates", // Sistema de OTA updates: podés actualizar el JS sin subir a la tienda.
      [
        "expo-splash-screen", // Plugin del splash screen (pantalla de carga inicial).
        {
          "image": "./assets/icon.png", // Imagen que se muestra en el splash.
          "imageWidth": 250, // Ancho de la imagen en el splash.
          "resizeMode": "contain", // Cómo se ajusta la imagen (contain = entra completa sin recortar).
          "backgroundColor": "#FFFFFF" // Color de fondo del splash.
        }
      ],
      [
        "expo-camera", // Plugin de cámara.
        {
          "cameraPermission": "KrustyBurger necesita acceso a la cámara para escanear códigos QR y cupones." // Texto del permiso de cámara en Android/iOS.
        }
      ],
      [
        "expo-image-picker", // Plugin para elegir imágenes de la galería o sacar fotos.
        {
          "photosPermission": "KrustyBurger necesita acceso a tus fotos para subir imágenes.", // Texto del permiso de galería.
          "cameraPermission": "KrustyBurger necesita acceso a la cámara para tomar fotos." // Texto del permiso de cámara.
        }
      ],
      [
        "expo-location", // Plugin de geolocalización.
        {
          "isIosBackgroundLocationEnabled": true, // Permite ubicación en background en iOS.
          "isAndroidBackgroundLocationEnabled": true, // Permite ubicación en background en Android.
          "isAndroidForegroundServiceEnabled": true, // Habilita un servicio en foreground para tracking continuo (necesario en Android 14+).
          "locationAlwaysAndWhenInUsePermission": "KrustyBurger necesita tu ubicación para el seguimiento de pedidos.", // Texto del permiso "siempre y cuando se use".
          "locationAlwaysPermission": "KrustyBurger necesita tu ubicación para el seguimiento de pedidos.", // Texto del permiso "siempre".
          "locationWhenInUsePermission": "KrustyBurger necesita tu ubicación para el seguimiento de pedidos." // Texto del permiso "mientras se usa".
        }
      ],
      [
        "expo-notifications", // Plugin de notificaciones push.
        {
          "icon": "./assets/notification-icon.png", // Ícono que se muestra en la notificación.
          "color": "#F5C518", // Color de acento de la notificación (Android).
          "sounds": [ // Sonidos custom que podés usar en las notificaciones.
            "./assets/sounds/krustyyotequieromucho.wav", // Sonido 1: el clásico de Krusty.
            "./assets/sounds/saxolisa.wav", // Sonido 2: el saxo de Lisa.
            "./assets/sounds/circopararapapa.wav" // Sonido 3: circo.
          ]
        }
      ],
      [
        "expo-build-properties", // Plugin CLAVE: permite tocar propiedades nativas de Gradle/Xcode sin eyectar.
        {
          "android": { // Config específica de Android.
            "compileSdkVersion": 36, // Versión del SDK con el que se COMPILA la app. Tiene que ser >= targetSdk.
            "targetSdkVersion": 36, // Versión del SDK contra la que se COMPORTA la app. Play Store exige que sea reciente (36 = Android 15/16).
            "buildToolsVersion": "36.0.0", // Versión de las build tools de Android.
            "enableMinifyInReleaseBuilds": true, // 🔥 Activa R8 en release. Ofusca, optimiza y elimina código muerto. Sin esto, Play Store te mata con el 2%.
            "enableShrinkResourcesInReleaseBuilds": true, // 🔥 Limpia recursos no usados (imágenes, layouts, strings). Reduce el tamaño del AAB y suma para Play Store.
            "extraProguardRules": "-keep class expo.modules.notifications.** { *; }\n-keepnames class expo.modules.notifications.** { *; }" // 🔥 Workaround para expo-notifications: la librería NO expone sus consumerProguardFiles al compilar con R8, y las notificaciones programadas fallan SILENCIOSAMENTE en release (expo/expo#45292). Esta regla le dice a R8 "no toques el paquete de notifications". Impacto mínimo en el % de ofuscación porque es un solo paquete.
          },
          "ios": { // Config específica de iOS.
            "deploymentTarget": "16.4" // Versión mínima de iOS soportada. iOS 16.4 en adelante.
          }
        }
      ],
      "./plugins/withAndroidManifest.js", // Plugin custom tuyo que modifica el AndroidManifest.xml. Acá metés config que Expo no expone.
      "expo-web-browser", // Abre links en un navegador in-app (SFSafariViewController / Custom Tabs).
      "@react-native-community/datetimepicker", // Selector de fecha/hora nativo.
      "expo-sharing", // Permite compartir archivos con otras apps (share sheet).
      "expo-image", // Componente de imagen optimizado (mejor que el Image de RN).
      "@sentry/react-native", // SDK de Sentry para capturar errores y crashes en producción.
      [
        "@sentry/react-native/expo", // Plugin de Sentry para Expo.
        {
          "url": "https://sentry.io/", // URL de Sentry.
          "project": "react-native", // Nombre del proyecto en Sentry.
          "organization": "powa-b6" // Organización en Sentry.
        }
      ]
    ],
    "updates": { // Config de OTA updates (expo-updates).
      "enabled": true, // Habilita OTA updates.
      "checkAutomatically": "ON_LOAD", // Chequea updates cada vez que se abre la app.
      "fallbackToCacheTimeout": 3000, // Si en 3 segundos no bajó el update, arranca con lo que tiene en caché. Para no dejar al user esperando.
      "url": "https://u.expo.dev/3bb3f5cf-a572-4703-8a2a-e727bc44a0e6" // URL del servidor de updates de EAS.
    },
    "extra": { // Datos extra que se inyectan en la app (accesibles vía Constants.expoConfig.extra).
      "router": {
        "origin": false // Desactiva el origen automático de expo-router. Se usa cuando la app corre en un dominio propio.
      },
      "eas": {
        "projectId": "3bb3f5cf-a572-4703-8a2a-e727bc44a0e6" // ID del proyecto en EAS. Vincula la app con el proyecto en expo.dev.
      }
    },
    "runtimeVersion": { // Versión de runtime para OTA updates.
      "policy": "appVersion" // El runtime version se ata a la version de la app. Si cambiás la version, los OTA updates viejos no aplican.
    },
    "owner": "agenciadigitalpowas-team" // Dueño del proyecto en Expo (tu organización/cuenta).
  }
}