      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCiAUoNj0Pf_U9hZvctk2wCToe-AjJvC1I"
        }
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "www.krustyburger.com.ar"
