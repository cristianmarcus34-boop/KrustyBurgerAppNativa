      ],
      [
        "expo-camera",
        {
          "cameraPermission": "KrustyBurger necesita acceso a la cámara para escanear códigos QR y cupones."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KrustyBurger necesita acceso a tus fotos para subir imágenes.",
